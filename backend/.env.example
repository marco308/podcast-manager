# Application
APP_NAME=Podcast Manager
# DEBUG also serves the API docs at /api/docs, /api/redoc and /api/openapi.json
DEBUG=false
# Log every SQL statement (bound parameters are never logged)
SQL_ECHO=false

# Database
DATABASE_URL=sqlite+aiosqlite:///./data/podcast_manager.db

# Spotify OAuth
# Register your app at: https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=your_spotify_client_id
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret
# IMPORTANT: Use https://127.0.0.1:8000 for local dev (not localhost)
# For production with Docker, use your actual domain
SPOTIFY_REDIRECT_URI=https://127.0.0.1:8000/api/auth/callback

# Security
# Generate with: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=your_fernet_key_here

# Your Spotify user ID (Spotify > Account overview > Username). When set, only
# this account can sign in, including the first sign-in on a fresh install.
# Empty: the first account to sign in becomes the owner.
OWNER_SPOTIFY_ID=


# Frontend URL for redirects after OAuth
FRONTEND_URL=https://127.0.0.1:3000

# Cookie domain for cross-subdomain sharing (e.g., ".example.com")
# Leave empty for local development (same-origin cookies)
COOKIE_DOMAIN=

# Scheduler (24-hour format)
PLAYLIST_UPDATE_HOUR=4
PLAYLIST_UPDATE_MINUTE=0
# IANA time zone the run times are in, e.g. Europe/London. Defaults to UTC.
# The scheduler follows daylight saving in that zone, and the Settings page
# labels the run times with it.
TIMEZONE=UTC
