# Podcast Manager - Environment Configuration
# Copy this file to .env and fill in your values

# =============================================================================
# Spotify OAuth (Required)
# =============================================================================
# Register your app at: https://developer.spotify.com/dashboard
# Add redirect URI: https://your-domain.com/api/auth/callback
SPOTIFY_CLIENT_ID=your_spotify_client_id
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret
SPOTIFY_REDIRECT_URI=https://your-domain.com/api/auth/callback

# =============================================================================
# Security (Required)
# =============================================================================
# Generate ENCRYPTION_KEY with:
#   python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=your_fernet_key_here

# Generate SECRET_KEY with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=your_secret_key_here

# =============================================================================
# Application Settings
# =============================================================================
APP_NAME=Podcast Manager
DEBUG=false
DATABASE_URL=sqlite+aiosqlite:///./data/podcast_manager.db
FRONTEND_URL=https://your-domain.com

# =============================================================================
# Scheduler Settings
# =============================================================================
# Time to run daily playlist updates (24-hour format, UTC)
PLAYLIST_UPDATE_HOUR=4
PLAYLIST_UPDATE_MINUTE=0
